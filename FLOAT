--------------------------------------------------------------------------------
-- EVENT LOGIC
--------------------------------------------------------------------------------

-- Update position loop
RunService.Heartbeat:Connect(function()
    character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    rootPart = character.HumanoidRootPart
    humanoid = character:FindFirstChildOfClass("Humanoid")

    if isAirWalkActive then
        airPlatform.CanCollide = true
        airPlatform.CFrame = CFrame.new(rootPart.Position.X, currentAirHeight - 2.5, rootPart.Position.Z)
    else
        airPlatform.CanCollide = false
        airPlatform.Position = Vector3.new(0, -500, 0)
    end
end)

-- Enable / Disable Air Walk
local function toggleAirWalk()
    isAirWalkActive = not isAirWalkActive
    if isAirWalkActive then
        toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 80)
        toggleBtn.Text = "Air Walk: ON"
        currentAirHeight = rootPart.Position.Y
    else
        toggleBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        toggleBtn.Text = "Air Walk: OFF"
    end
end

toggleBtn.MouseButton1Click:Connect(toggleAirWalk)

-- Close Button functionality (Hides frame)
closeBtn.MouseButton1Click:Connect(function()
    mainFrame.Visible = false
end)

-- Key inputs (Space to jump, L-Ctrl to descend, R-Ctrl to reopen menu)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    -- Press Right Control to toggle GUI visibility back ON/OFF
    if input.KeyCode == Enum.KeyCode.RightControl then
        mainFrame.Visible = not mainFrame.Visible
    end
    
    if not isAirWalkActive then return end
    
    -- Jump higher on Space
    if input.KeyCode == Enum.KeyCode.Space then
        currentAirHeight = currentAirHeight + heightIncrement
        if humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
    
    -- Descend on Left Control
    if input.KeyCode == Enum.KeyCode.LeftControl then
        currentAirHeight = currentAirHeight - heightIncrement
    end
end)

-- Reset handling on death
player.CharacterAdded:Connect(function(newChar)
    character = newChar
    rootPart = character:WaitForChild("HumanoidRootPart")
    humanoid = character:WaitForChild("Humanoid")
    if isAirWalkActive then
        toggleAirWalk()
    end
end)
